APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s

DATABASE_URL=postgres://dexta:dexta@localhost:5432/dexta?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_MIGRATIONS_PATH=file://internal/db/migrations
DATABASE_AUTO_MIGRATE=true

JWT_SECRET=dexta-africa-enterprise-secret-key-at-least-32-chars-long
JWT_ACCESS_TOKEN_TTL=24h

ADMIN_BOOTSTRAP_EMAIL=admin@dexta.africa
ADMIN_BOOTSTRAP_PASSWORD=AdminPassword2026!

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

RATE_LIMIT_PUBLIC_RPS=2
RATE_LIMIT_PUBLIC_BURST=10

FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=dexta-frontend-revalidate-secret-2026
FRONTEND_REVALIDATE_TIMEOUT=5s

NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
NEWSLETTER_WEBHOOK_TIMEOUT=5s
