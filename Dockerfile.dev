# Development image: full Go toolchain + air for hot reload on file change.
# Source is expected to be bind-mounted over /app by docker-compose.dev.yml,
# so COPY here only seeds the initial build — the running container reads
# live edits from the mount, not this layer.
FROM golang:1.23-alpine
WORKDIR /app

RUN apk add --no-cache ca-certificates git \
    && go install github.com/air-verse/air@v1.61.1

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

ENTRYPOINT ["air", "-c", ".air.toml"]
