# Copy to .env for local development. Never commit the real .env file.
# In staging/production, set these as real environment variables/secrets —
# the application does not ship with defaults for anything sensitive.

# --- App ---
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=15s
REQUEST_TIMEOUT=30s

# --- Database ---
DATABASE_URL=postgres://dexta:dexta@localhost:5432/dexta?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_MIGRATIONS_PATH=file://internal/db/migrations
DATABASE_AUTO_MIGRATE=true

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_ACCESS_TOKEN_TTL=24h

# Seeds the first CMS admin on boot. Only takes effect while the admins
# table is empty; leave unset after the first admin is created.
ADMIN_BOOTSTRAP_EMAIL=admin@dexta.africa
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password

# --- CORS ---
# Comma-separated list of exact origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting (public form endpoints) ---
RATE_LIMIT_PUBLIC_RPS=2
RATE_LIMIT_PUBLIC_BURST=10

# --- Frontend revalidation webhook ---
# Must match the Next.js frontend's CONTENT_REVALIDATION_SECRET.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=change-me-shared-with-frontend
FRONTEND_REVALIDATE_TIMEOUT=5s

# --- Newsletter webhook (optional; forwards subscriptions to an email/CRM provider) ---
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
NEWSLETTER_WEBHOOK_TIMEOUT=5s
