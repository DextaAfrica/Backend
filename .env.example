# Dexta Africa Enterprise Core Engine Configuration

# Application
APP_NAME=DextaAfrica-API
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_WEB_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dexta_user
DB_PASSWORD=dexta_secret_password_2026
DB_NAME=dexta_africa
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME_MINS=30

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & JWT
JWT_SECRET=super-secret-dexta-africa-enterprise-key-2026-change-in-prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Rate Limiting
RATE_LIMITER_ENABLED=true
RATE_LIMITER_MAX_REQS=120
RATE_LIMITER_WINDOW_SEC=60

# Transactional Mail (Mailpit in development, Resend / SendGrid / SES in production)
MAIL_PROVIDER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=notifications@dextaafrica.com
MAIL_FROM_NAME="Dexta Africa"

# Cloud Storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=dexta-assets
STORAGE_REGION=auto

